# 只在开发模式中被载入
ENV = 'development'

# 公共基础路径, 详见: https://cn.vitejs.dev/guide/build.html#public-base-path
VITE_BASE_URL = /

# Browser calls same-origin /api. Vite proxies that to the public nest-admin demo.
# Generated clients already prefix /api, and the dev proxy strips one /api segment.
VITE_BASE_API_URL = '/api'

# Local NestJS backend API
VITE_API_PROXY_TARGET = http://127.0.0.1:7001

VITE_DROP_CONSOLE = false
