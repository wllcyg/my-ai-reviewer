{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "RuoYiApplication",
      "request": "launch",
      "mainClass": "com.ruoyi.RuoYiApplication",
      "projectName": "ruoyi-admin"
    },
    {
      "name": "Python: 运行/调试当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "FastAPI: 启动服务 (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
